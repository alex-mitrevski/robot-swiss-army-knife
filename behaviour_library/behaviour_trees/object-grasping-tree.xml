<root BTCPP_format="4">
    <BehaviorTree ID="ObjectGrasping">
        <Sequence>
            <!-- Object detection and pose estimation -->
            <MoveArmToNamedPoseBehaviour name="named_pose_publisher_home" goal_topic_name="go_to_named_pose" result_topic_name="trajectory_execution_result" pose_name="home" />

            <RetryUntilSuccessful num_attempts="-1">
                <ImageSubBehaviour name="image_subscriber" topic_name="/head_front_camera/rgb/image_raw" latest_image="{latest_image}" />
            </RetryUntilSuccessful>
            <CheckVisibilityBehaviour name="visibility_checker" service_name="check_objects_visible" latest_image="{latest_image}" object_categories="bottle" visible_objects="{visible_objects}" />
            <SegmentObjectsBehaviour name="object_segmenter" service_name="segment_objects" latest_image="{latest_image}" object_categories="bottle" segmented_objects="{segmented_objects}" />
            <RetryUntilSuccessful num_attempts="-1">
                <PointCloudSubBehaviour name="cloud_subscriber" topic_name="/head_front_camera/depth/rgb/points" latest_point_cloud="{latest_point_cloud}" />
            </RetryUntilSuccessful>
            <ExtractROI3DPointsBehaviour name="roi_extractor" service_name="extract_3d_rois" latest_point_cloud="{latest_point_cloud}" segmented_objects="{segmented_objects}" objects="{objects}" />
            <CalculatePoseBehaviour name="pose_calculator" service_name="calculate_pose_from_cloud" objects="{objects}" object_of_interest="bottle" object_with_pose="{object_with_pose}" />
            <ObjectPosePubBehaviour name="object_pose_publisher" topic_name="object_pose" object="{object_with_pose}" />
            <!--======================================-->

            <!-- Object grasping -->
            <MoveArmToNamedPoseBehaviour name="named_pose_publisher_pregrasp" goal_topic_name="go_to_named_pose" result_topic_name="trajectory_execution_result" pose_name="pregrasp" />

            <PickObjectBehaviour name="object_grasper" action_name="/skill/pick" object_to_grasp="{object_with_pose}" />

            <MoveArmToNamedPoseBehaviour name="named_pose_publisher_retreat" goal_topic_name="go_to_named_pose" result_topic_name="trajectory_execution_result" pose_name="home" />
            <!--======================================-->
        </Sequence>
    </BehaviorTree>
</root>